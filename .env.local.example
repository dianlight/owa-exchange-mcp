# Copy to .env.local (gitignored) and fill in your values.
# Read by exchange_mcp/server.py at startup — only used when the process has
# no shell/MCP-client env to inherit from, e.g. the Windows autostart task in
# scripts/install_autostart_task.ps1. Values already present in the real
# environment always take precedence over this file.

EXCHANGE_OWA_URL=https://owa.example.com
# Persistent Chromium profile. Default: <repo>/.browser-profile in a source
# checkout, ~/owa-mcp/.browser-profile for an installed package.
EXCHANGE_BROWSER_PROFILE_DIR=
# Seconds the sign-in window waits for the user before giving up (default 300).
EXCHANGE_LOGIN_TIMEOUT=300
# The mailbox's own timezone, as a Windows id ("W. Europe Standard Time") or an
# IANA one ("Europe/Rome"). One variable, two consumers, same meaning:
#   - the TimeZoneContext every write goes out in (mailbox_timezone.py, #8)
#   - the local working-hours grid UTC free/busy times are placed on in
#     find_free_time / find_meeting_time (availability_frame.py, #601/#602)
# Leave it empty, which is what you want: the zone is read from the mailbox's
# own OWA configuration once per process. Set it only when that lookup gets it
# wrong or the server won't accept what it returned. Writes fall back to UTC;
# the availability grid falls back to not shifting at all and says so. An IANA
# id always resolves for the grid; a Windows id needs the `tzdata` package on
# a system without a zoneinfo database.
EXCHANGE_TIMEZONE=
EXCHANGE_MCP_TRANSPORT=http
EXCHANGE_MCP_HOST=127.0.0.1
EXCHANGE_MCP_PORT=8765
# Where capability-discovery captures are written. Default: <repo>/.discovery-sessions
# in a source checkout, ~/owa-mcp/discovery-sessions for an installed package.
# Captures hold real mailbox metadata - keep them out of anything you share.
EXCHANGE_DISCOVERY_DIR=
